{
  "name": "cratesort",
  "productName": "CrateSort",
  "version": "2.8.1",
  "description": "Rangement de morceaux pour DJ",
  "main": "main.js",
  "private": true,
  "author": "Fulberitodesign",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fulberitodesign/cratesort.git"
  },
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "npm run sync && electron .",
    "build:win": "npm run sync && electron-builder --win --publish never",
    "build:mac": "npm run sync && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.cratesort.app",
    "productName": "CrateSort",
    "copyright": "Fulberitodesign",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "serato.js",
      "macupdate.js",
      "CrateSort.html",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/CrateSort.icns",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "CrateSort-Mac.${ext}"
    },
    "dmg": {
      "title": "CrateSort ${version}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/CrateSort.ico",
      "artifactName": "CrateSort-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CrateSort",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Fulberitodesign",
        "repo": "cratesort",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
