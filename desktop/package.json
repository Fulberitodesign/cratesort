{
  "name": "cratesort",
  "productName": "CrateSort",
  "version": "2.1.0",
  "description": "Rangement de morceaux pour DJ",
  "main": "main.js",
  "private": true,
  "author": "Fulberitodesign",
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "npm run sync && electron .",
    "build:mac": "npm run sync && electron-packager . CrateSort --platform=darwin --arch=x64 --icon=assets/CrateSort.icns --app-bundle-id=local.cratesort.app --app-category-type=public.app-category.music --out=dist --overwrite --asar --ignore=^/dist --ignore=^/scripts --ignore=^/assets --ignore=^/node_modules",
    "build:mac-arm": "npm run sync && electron-packager . CrateSort --platform=darwin --arch=arm64 --icon=assets/CrateSort.icns --app-bundle-id=local.cratesort.app --app-category-type=public.app-category.music --out=dist --overwrite --asar --ignore=^/dist --ignore=^/scripts --ignore=^/assets --ignore=^/node_modules",
    "build:win": "npm run sync && electron-packager . CrateSort --platform=win32 --arch=x64 --icon=assets/CrateSort.ico --win32metadata.ProductName=CrateSort --win32metadata.FileDescription=CrateSort --out=dist --overwrite --asar --ignore=^/dist --ignore=^/scripts --ignore=^/assets --ignore=^/node_modules"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "43.7.7"
  }
}
